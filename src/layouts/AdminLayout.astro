---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const admin = Astro.locals.admin;
const csrfToken = Astro.locals.csrfToken;
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Panel administracyjny</title>
  </head>
  <body>
    <div class="admin-shell">
      <aside class="admin-sidebar">
        <p><strong>Panel admina</strong></p>
        {admin && <p style="opacity:.75;font-size:.85rem;">{admin.username}</p>}
        <nav>
          <a href="/admin">Pulpit</a>
          <a href="/admin/news">Aktualności</a>
          <a href="/admin/documents">Do pobrania</a>
          <a href="/admin/gallery">Galeria</a>
          <a href="/admin/gallery/karuzela">Karuzela zdjęć</a>
          <a href="/admin/konkurencje">Konkurencje</a>
          <a href="/admin/uzytkownicy">Użytkownicy</a>
        </nav>
        <a href="/polityka-prywatnosci" style="margin-top:1.5rem;display:block;font-size:.85rem;opacity:.75;">Polityka prywatności</a>
        <form method="POST" action={`/api/admin/logout?csrf_token=${csrfToken}`} style="margin-top:.75rem;">
          <button type="submit" class="danger">Wyloguj</button>
        </form>
      </aside>
      <div class="admin-main">
        <slot />
      </div>
    </div>
    <script>
      document.querySelectorAll<HTMLFormElement>("form[data-confirm]").forEach((form) => {
        form.addEventListener("submit", (e) => {
          if (!confirm(form.dataset.confirm)) e.preventDefault();
        });
      });

      // "Usuń plik/zdjęcie" toggles — a button (not a native checkbox) that flips a
      // hidden field's value between "" and "on" and relabels itself so the marked-
      // for-removal state is obvious before the form is actually submitted.
      document.querySelectorAll<HTMLElement>("[data-remove-toggle]").forEach((wrap) => {
        const hidden = wrap.querySelector<HTMLInputElement>('input[type="hidden"]');
        const button = wrap.querySelector<HTMLButtonElement>("button");
        if (!hidden || !button) return;
        const defaultLabel = button.textContent ?? "";
        button.addEventListener("click", () => {
          const willRemove = hidden.value !== "on";
          hidden.value = willRemove ? "on" : "";
          button.classList.toggle("danger", willRemove);
          button.classList.toggle("secondary", !willRemove);
          button.textContent = willRemove ? "Cofnij usunięcie" : defaultLabel;
        });
      });
    </script>
  </body>
</html>
