---
import type { NewsPost } from "../lib/db";
import { mediaUrl } from "../lib/media";

interface Props {
  post: NewsPost;
  mediaBaseUrl: string;
}

const { post, mediaBaseUrl } = Astro.props;

function formatDate(iso: string | null): string {
  if (!iso) return "";
  return new Date(iso).toLocaleDateString("pl-PL", { year: "numeric", month: "long", day: "numeric" });
}
---

<article class="card">
  {post.cover_image_key && (
    <img
      src={mediaUrl(mediaBaseUrl, post.cover_image_key)}
      alt=""
      loading="lazy"
      style="width:100%;height:140px;object-fit:cover;border-radius:6px;margin-bottom:.75rem;"
    />
  )}
  <h3><a href={`/aktualnosci/${post.slug}`}>{post.title}</a></h3>
  <p class="doc-meta">{formatDate(post.published_at)}</p>
  {post.excerpt && <p>{post.excerpt}</p>}
  <a href={`/aktualnosci/${post.slug}`}>Czytaj więcej &rarr;</a>
</article>
