---
import { Image } from "astro:assets";

import lzsLogo from "../assets/logo/lzs-logo-150dpi.png";
import lzs80Lat from "../assets/logo/LOGO_80 lecia.jpg";

import mon from "../assets/sponsors/orzeł_mon_logo.jpg";
import msit from "../assets/sponsors/MSiT Nowe.png";
import mrirw from "../assets/sponsors/MRiRW.png";
import marszalek from "../assets/sponsors/marszalek-wielkopolskie.png";
import starostaPoznanski from "../assets/sponsors/powiat-poznanski-jan-grabowski-starosta-poznanski.png";
import radioPoznan from "../assets/sponsors/radio-poznan.png";

import gminaSteszew from "../assets/sponsors/Gmina Stęszew.png";
import gminaKomorniki from "../assets/sponsors/herb_Komorniki (1).jpg";
import powiatPoznanski from "../assets/sponsors/herb powiat poznański.jpg";
import muzeumSzreniawa from "../assets/sponsors/logo_muzeum_h125.png";
import tvp3 from "../assets/sponsors/TVP3_Poznan_podst-1.png";

// `key` links a logo to its matching written-list entry (in this section or
// another) so hovering either one can highlight both — omitted where a logo
// has no single corresponding line in the text (e.g. the LZS 80-lecia mark).
const organizatorzy = [
  { src: lzsLogo, alt: "Ludowe Zespoły Sportowe", key: "lzs" },
  { src: lzs80Lat, alt: "80 lat Ludowych Zespołów Sportowych" },
];

const honorowyPatronat = [
  { src: mon, alt: "Ministerstwo Obrony Narodowej", key: "mon" },
  { src: msit, alt: "Ministerstwo Sportu i Turystyki", key: "msit" },
  { src: mrirw, alt: "Ministerstwo Rolnictwa i Rozwoju Wsi", key: "mrirw" },
  { src: marszalek, alt: "Marszałek Województwa Wielkopolskiego", key: "marszalek" },
  { src: starostaPoznanski, alt: "Starosta Poznański", key: "starosta" },
];

const patronatMedialny = [
  { src: radioPoznan, alt: "Radio Poznań", key: "radio-poznan" },
  { src: tvp3, alt: "TVP3 Poznań", key: "tvp3" },
];

// Only the four sponsors without a logo shown anywhere else on the page get
// one here — Ministerstwo Sportu i Turystyki, Ministerstwo Rolnictwa,
// Samorząd Województwa Wielkopolskiego (no dedicated logo at all), Radio
// Poznań and TVP Poznań are already pictured above, so their keys still
// cross-highlight those lines without repeating the image.
const partnerzy = [
  { src: gminaSteszew, alt: "Gmina Stęszew", key: "gmina-steszew" },
  { src: gminaKomorniki, alt: "Gmina Komorniki", key: "gmina-komorniki" },
  { src: powiatPoznanski, alt: "Powiat Poznański", key: "powiat" },
  { src: muzeumSzreniawa, alt: "Muzeum Narodowe Rolnictwa i Przemysłu Rolno-Spożywczego w Szreniawie", key: "muzeum" },
];
---

<section class="partners" data-partners-hover>
  <p class="partners__funding">Igrzyska dofinansowano ze środków Ministerstwa Sportu i Turystyki.</p>

  <h2>Organizatorzy</h2>
  <ul class="partners__list">
    <li data-key="lzs">Krajowe Zrzeszenie LZS</li>
    <li>Wielkopolskie Zrzeszenie LZS w Poznaniu</li>
  </ul>
  <div class="partners__grid">
    {organizatorzy.map((logo) => (
      <div class="partners__item" data-key={logo.key}>
        <Image src={logo.src} alt={logo.alt} width={160} />
      </div>
    ))}
  </div>

  <h2>Honorowy patronat</h2>
  <p>Impreza odbywa się pod Honorowym Patronatem:</p>
  <ul class="partners__list">
    <li data-key="mon">Wiceprezesa Rady Ministrów, Ministra Obrony Narodowej Władysława Kosiniaka-Kamysza</li>
    <li data-key="msit">Ministra Sportu i Turystyki Jakuba Rutnickiego</li>
    <li data-key="mrirw">Ministra Rolnictwa i Rozwoju Wsi Stefana Krajewskiego</li>
    <li data-key="marszalek">Marszałka Województwa Wielkopolskiego Marka Woźniaka</li>
    <li data-key="starosta">Starosty Poznańskiego Jana Grabkowskiego</li>
  </ul>
  <div class="partners__grid">
    {honorowyPatronat.map((logo) => (
      <div class="partners__item" data-key={logo.key}>
        <Image src={logo.src} alt={logo.alt} width={160} />
      </div>
    ))}
  </div>

  <h2>Patronat medialny</h2>
  <ul class="partners__list">
    <li data-key="radio-poznan">Radio Poznań</li>
    <li data-key="tvp3">TVP3 Poznań</li>
  </ul>
  <div class="partners__grid">
    {patronatMedialny.map((logo) => (
      <div class="partners__item" data-key={logo.key}>
        <Image src={logo.src} alt={logo.alt} width={160} />
      </div>
    ))}
  </div>

  <h2>Partnerzy i sponsorzy</h2>
  <ul class="partners__list">
    <li data-key="msit">Ministerstwo Sportu i Turystyki</li>
    <li data-key="mrirw">Ministerstwo Rolnictwa i Rozwoju Wsi</li>
    <li data-key="marszalek">Samorząd Województwa Wielkopolskiego</li>
    <li data-key="powiat">Powiat Poznański</li>
    <li data-key="gmina-steszew">Gmina Stęszew</li>
    <li data-key="gmina-komorniki">Gmina Komorniki</li>
    <li data-key="muzeum">Muzeum Narodowe Rolnictwa i Przemysłu Rolno-Spożywczego w Szreniawie</li>
    <li data-key="radio-poznan">Radio Poznań</li>
    <li data-key="tvp3">TVP Poznań</li>
    <li>Powiatowe Zrzeszenie LZS w Wolsztynie</li>
    <li>Rady Sołeckie</li>
    <li>Koła Gospodyń Wiejskich</li>
    <li>Związek Ochotniczych Straży Pożarnych</li>
  </ul>
  <div class="partners__grid">
    {partnerzy.map((logo) => (
      <div class="partners__item" data-key={logo.key}>
        <Image src={logo.src} alt={logo.alt} width={160} />
      </div>
    ))}
  </div>
</section>

<script src="../scripts/partners-hover.ts"></script>
