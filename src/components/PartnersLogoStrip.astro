---
import { Image } from "astro:assets";

import lzsLogo from "../assets/logo/lzs-logo-150dpi.png";
import lzs80Lat from "../assets/logo/LOGO_80 lecia.jpg";

import mon from "../assets/sponsors/orzeł_mon_logo.png";
import msit from "../assets/sponsors/MSiT Nowe.png";
import mrirw from "../assets/sponsors/MRiRW.png";
import arimr from "../assets/sponsors/ARiMR_logo_PODSTAWOWE.jpg";
import marszalek from "../assets/sponsors/marszalek-wielkopolskie.png";
import starostaPoznanski from "../assets/sponsors/powiat-poznanski-jan-grabowski-starosta-poznanski.png";
import radioPoznan from "../assets/sponsors/radio-poznan.png";
import tvp3 from "../assets/sponsors/TVP3_Poznan_podst-1.png";

import gminaSteszew from "../assets/sponsors/Gmina Stęszew.png";
import gminaKomorniki from "../assets/sponsors/herb_Komorniki (1).jpg";
import kowr from "../assets/sponsors/logo_KOWR_skrot.png";
import mielczarek from "../assets/sponsors/Zakłady Mięsne Mielczarek.jpg";
import krus from "../assets/sponsors/Logo_KRUS_kontra-1.png";
import powiatPoznanski from "../assets/sponsors/herb powiat poznański.jpg";
import muzeumSzreniawa from "../assets/sponsors/logo_muzeum_h125.png";
import instytutWitosa from "../assets/sponsors/Instytut Witosa.png";

const logos = [
  { src: lzsLogo, alt: "Ludowe Zespoły Sportowe" },
  { src: lzs80Lat, alt: "80 lat Ludowych Zespołów Sportowych" },
  { src: mon, alt: "Ministerstwo Obrony Narodowej" },
  { src: msit, alt: "Ministerstwo Sportu i Turystyki" },
  { src: mrirw, alt: "Ministerstwo Rolnictwa i Rozwoju Wsi" },
  { src: arimr, alt: "Agencja Restrukturyzacji i Modernizacji Rolnictwa" },
  { src: marszalek, alt: "Marszałek Województwa Wielkopolskiego" },
  { src: starostaPoznanski, alt: "Starosta Poznański" },
  { src: gminaSteszew, alt: "Gmina Stęszew" },
  { src: gminaKomorniki, alt: "Gmina Komorniki" },
  { src: kowr, alt: "Krajowy Ośrodek Wsparcia Rolnictwa" },
  { src: mielczarek, alt: "Zakłady Mięsne Mielczarek" },
  { src: krus, alt: "Kasa Rolniczego Ubezpieczenia Społecznego" },
  { src: powiatPoznanski, alt: "Powiat Poznański" },
  { src: muzeumSzreniawa, alt: "Muzeum Narodowe Rolnictwa i Przemysłu Rolno-Spożywczego w Szreniawie" },
  { src: instytutWitosa, alt: "Instytut Witosa" },
  { src: radioPoznan, alt: "Radio Poznań" },
  { src: tvp3, alt: "TVP3 Poznań" },
];
---

<section class="partners-strip">
  <h2>Organizatorzy, patroni i partnerzy</h2>
  <div class="partners-strip__grid">
    {logos.map((logo) => (
      <div
        class:list={[
          "partners-strip__item",
          { "partners-strip__item--muzeum": logo.src === muzeumSzreniawa },
          { "partners-strip__item--marszalek": logo.src === marszalek },
          { "partners-strip__item--arimr": logo.src === arimr },
        ]}
      >
        <Image
          src={logo.src}
          alt={logo.alt}
          width={logo.src === muzeumSzreniawa ? 300 : logo.src === marszalek || logo.src === arimr ? 250 : 190}
        />
      </div>
    ))}
  </div>
  <p><a href="/informacje/organizatorzy">Pełna lista organizatorów i partnerów &rarr;</a></p>
</section>
