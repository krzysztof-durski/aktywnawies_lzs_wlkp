---
// Paired with any `.gallery-thumb` links elsewhere on the page (grid or carousel) —
// scans the whole page rather than one specific container, so a single overlay
// instance works for both GalleryLightbox.astro and Carousel.astro.
---

<div id="lightbox" class="lightbox" hidden>
  <button type="button" class="lightbox-close" aria-label="Zamknij">&times;</button>
  <button type="button" class="lightbox-prev" aria-label="Poprzednie zdjęcie">&lsaquo;</button>
  <figure class="lightbox-figure">
    <img class="lightbox-img" alt="" />
    <figcaption class="lightbox-caption"></figcaption>
  </figure>
  <button type="button" class="lightbox-next" aria-label="Następne zdjęcie">&rsaquo;</button>
</div>

<script src="../scripts/lightbox.ts"></script>
