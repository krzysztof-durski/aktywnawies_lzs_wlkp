---
import type { GalleryImage } from "../lib/db";
import { mediaUrl } from "../lib/media";
import LightboxOverlay from "./LightboxOverlay.astro";

interface Props {
  images: GalleryImage[];
  mediaBaseUrl: string;
}

const { images, mediaBaseUrl } = Astro.props;
---

{images.length > 0 && (
  <div class="carousel">
    <div class="carousel-inner">
      <button type="button" class="carousel-prev" aria-label="Poprzednie zdjęcie">&lsaquo;</button>
      <div class="carousel-track" id="carousel-track">
        {images.map((img) => (
          <a
            href={mediaUrl(mediaBaseUrl, img.file_key)}
            class:list={["gallery-thumb", "carousel-slide", { "carousel-slide--full": !!img.featured_full_width }]}
            data-caption={img.caption ?? ""}
          >
            <img src={mediaUrl(mediaBaseUrl, img.thumb_key ?? img.file_key)} alt={img.caption ?? ""} loading="lazy" />
          </a>
        ))}
      </div>
      <button type="button" class="carousel-next" aria-label="Następne zdjęcie">&rsaquo;</button>
    </div>
    <LightboxOverlay />
  </div>
)}

<script src="../scripts/carousel.ts"></script>
