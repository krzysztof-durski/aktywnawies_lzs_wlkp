---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocumentList from "../../components/DocumentList.astro";
import { listDocumentsByCategory } from "../../lib/db";
import { informacjeItem } from "../../lib/nav";

const { env } = Astro.locals.runtime;
const { slug } = Astro.params;
const item = slug ? informacjeItem(slug) : undefined;
if (!item || item.kind !== "document") return new Response("Not found", { status: 404 });

const { results: documents } = await listDocumentsByCategory(env.DB, item.slug);
---

<BaseLayout title={item.title}>
  <div class="container">
    <p class="breadcrumb"><a href="/">Strona główna</a> / Informacje</p>
    <h1>{item.title}</h1>
    <DocumentList documents={documents} mediaBaseUrl={env.MEDIA_BASE_URL} />
  </div>
</BaseLayout>
