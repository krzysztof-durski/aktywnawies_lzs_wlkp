---
const { env } = Astro.locals.runtime;
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSiteSetting } from "../../lib/db";
import { mediaUrl } from "../../lib/media";
import fallbackRegulaminUrl from "../../assets/docs/Regulamin Aktywna Wieś Szreniawa.pdf?url";

const title = (await getSiteSetting(env.DB, "regulamin_glowny_title")) || "Regulamin V Ogólnopolskich Igrzysk LZS „Aktywna Wieś”";
const key = await getSiteSetting(env.DB, "regulamin_glowny_key");
const regulaminUrl = key ? mediaUrl(env.MEDIA_BASE_URL, key) : fallbackRegulaminUrl;
---

<BaseLayout title="Regulamin Igrzysk">
  <div class="container">
    <p class="breadcrumb"><a href="/">Strona główna</a> / Informacje</p>
    <h1>Regulamin Igrzysk</h1>
    <ul class="doc-list">
      <li>
        <div class="doc-row">
          <span>{title}</span>
          <span class="doc-meta">
            <button type="button" class="button secondary" data-preview-toggle>Podgląd</button>
            {" "}
            <a class="button secondary" href={regulaminUrl} download>Pobierz</a>
          </span>
        </div>
        <div class="doc-preview-wrap" hidden>
          <iframe class="doc-preview" data-src={regulaminUrl} title="Regulamin Igrzysk" loading="lazy" />
        </div>
      </li>
    </ul>
  </div>
</BaseLayout>

<script src="../../scripts/doc-preview-toggle.ts"></script>
