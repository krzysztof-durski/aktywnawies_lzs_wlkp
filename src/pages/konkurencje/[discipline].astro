---
const { env } = Astro.locals.runtime;
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocumentList from "../../components/DocumentList.astro";
import { getDiscipline, listDocumentsByDiscipline } from "../../lib/db";
import { mediaUrl } from "../../lib/media";

const { discipline: disciplineSlug } = Astro.params;
if (!disciplineSlug) return new Response("Not found", { status: 404 });

const discipline = await getDiscipline(env.DB, disciplineSlug);
if (!discipline) return new Response("Not found", { status: 404 });

const { results: documents } = await listDocumentsByDiscipline(env.DB, discipline.slug);
---

<BaseLayout title={discipline.title}>
  {discipline.cover_image_key ? (
    <div
      class="discipline-hero"
      style={`background-image: linear-gradient(rgba(10,15,12,.15), rgba(10,15,12,.15)), url(${mediaUrl(env.MEDIA_BASE_URL, discipline.cover_image_key)})`}
    >
      <h1>{discipline.title}</h1>
    </div>
  ) : null}
  <div class="container">
    <p class="breadcrumb">
      <a href="/">Strona główna</a> / <a href="/konkurencje">Konkurencje</a>
    </p>
    {!discipline.cover_image_key && <h1>{discipline.title}</h1>}
    {discipline.body_html ? (
      <div set:html={discipline.body_html} />
    ) : (
      <p class="empty-state">Opis dyscypliny w przygotowaniu.</p>
    )}
    {(discipline.regulamin_key || discipline.listy_startowe_key || discipline.wyniki_key) && (
      <>
        <h2>Dokumenty konkurencji</h2>
        <ul class="doc-list">
          {discipline.regulamin_key && (
            <li><a href={mediaUrl(env.MEDIA_BASE_URL, discipline.regulamin_key)}>Regulamin (PDF)</a></li>
          )}
          {discipline.listy_startowe_key && (
            <li><a href={mediaUrl(env.MEDIA_BASE_URL, discipline.listy_startowe_key)}>Listy startowe</a></li>
          )}
          {discipline.wyniki_key && (
            <li><a href={mediaUrl(env.MEDIA_BASE_URL, discipline.wyniki_key)}>Wyniki</a></li>
          )}
        </ul>
      </>
    )}

    {discipline.regulamin_text && (
      <section id="regulamin">
        <h2>Regulamin</h2>
        <div set:html={discipline.regulamin_text} />
      </section>
    )}

    <h2>Materiały</h2>
    <DocumentList documents={documents} mediaBaseUrl={env.MEDIA_BASE_URL} emptyLabel="Brak materiałów dla tej dyscypliny." />
  </div>
</BaseLayout>
