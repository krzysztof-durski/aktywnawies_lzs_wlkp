---
import { env } from "cloudflare:workers";
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { getPage } from "../../../../lib/db";

const { slug } = Astro.params;
if (!slug) return new Response("Not found", { status: 404 });

const page = await getPage(env.DB, slug);
if (!page) return new Response("Not found", { status: 404 });

const hasError = Astro.url.searchParams.get("error");
const csrfToken = Astro.locals.csrfToken;
---

<AdminLayout title={`Edytuj: ${page.title}`}>
  <h1>Edytuj: {page.title}</h1>
  {hasError && <p class="form-error">Tytuł jest wymagany.</p>}
  <form class="stacked" method="POST" action={`/api/admin/pages/${slug}?csrf_token=${csrfToken}`}>
    <label>
      Tytuł
      <input type="text" name="title" value={page.title} required />
    </label>
    <label>
      Treść (HTML)
      <textarea name="body_html">{page.body_html}</textarea>
    </label>
    <button type="submit">Zapisz</button>
    <a class="button secondary" href="/admin/pages">Anuluj</a>
  </form>
</AdminLayout>
