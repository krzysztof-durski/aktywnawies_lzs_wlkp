---
const { env } = Astro.locals.runtime;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { listAllPages } from "../../../lib/db";

const { results: pages } = await listAllPages(env.DB);
const saved = Astro.url.searchParams.get("saved");
---

<AdminLayout title="Strony">
  <h1>Strony</h1>
  {saved && <p class="form-error" style="background:#e8f5ea;border-color:#a8d5b0;color:#256029;">Zapisano.</p>}
  <table class="admin-table">
    <thead>
      <tr><th>Tytuł</th><th>Slug</th><th>Zaktualizowano</th><th></th></tr>
    </thead>
    <tbody>
      {pages.map((page) => (
        <tr>
          <td>{page.title}</td>
          <td>{page.slug}</td>
          <td>{new Date(page.updated_at).toLocaleString("pl-PL")}</td>
          <td><a href={`/admin/pages/${page.slug}/edit`}>Edytuj</a></td>
        </tr>
      ))}
    </tbody>
  </table>
</AdminLayout>
