---
import { env } from "cloudflare:workers";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { listDocumentCategorySuggestions, listAllDisciplinesAdmin } from "../../../lib/db";
import { KONKURENCJE_BLOCKS } from "../../../lib/nav";

const categories = await listDocumentCategorySuggestions(env.DB);
const { results: disciplines } = await listAllDisciplinesAdmin(env.DB);

const errorParam = Astro.url.searchParams.get("error");
const ERROR_MESSAGES: Record<string, string> = {
  missing: "Tytuł, kategoria i plik są wymagane.",
  too_large: "Plik jest za duży (limit 20MB).",
  not_pdf: "Plik nie wygląda na prawidłowy PDF.",
};
const errorMessage = errorParam ? ERROR_MESSAGES[errorParam] ?? "Wystąpił błąd." : null;
const csrfToken = Astro.locals.csrfToken;
---

<AdminLayout title="Nowy dokument">
  <h1>Nowy dokument</h1>
  {errorMessage && <p class="form-error">{errorMessage}</p>}
  <form class="stacked" method="POST" enctype="multipart/form-data" action={`/api/admin/documents?csrf_token=${csrfToken}`}>
    <label>
      Tytuł
      <input type="text" name="title" id="title-input" required />
    </label>
    <label>
      Kategoria
      <input type="text" name="category" list="category-suggestions" required />
      <datalist id="category-suggestions">
        {categories.map((c) => <option value={c} />)}
      </datalist>
    </label>
    <label>
      Dyscyplina lub blok (opcjonalnie)
      <input type="text" name="discipline" list="discipline-suggestions" />
      <datalist id="discipline-suggestions">
        {disciplines.map((d) => <option value={d.slug} />)}
        {KONKURENCJE_BLOCKS.map((b) => <option value={b.slug} />)}
      </datalist>
    </label>
    <p class="doc-meta">
      Wpisz slug konkretnej konkurencji (np. <code>pilka-nozna-kobiet</code>) razem z kategorią
      <code>regulamin</code>/<code>listy-startowe</code>/<code>wyniki</code>, aby dokument pojawił się w tabeli
      konkurencji danego bloku. Wpisz slug całego bloku (<code>sportowy</code>/<code>rekreacyjny</code>/<code>integracyjny</code>)
      bez konkretnej kategorii, aby dokument pojawił się jako ogólny link na górze strony bloku (np. „Druk zgłoszeń”).
    </p>
    <label>
      Plik PDF
      <input type="file" name="file" id="file-input" accept="application/pdf" required />
    </label>
    <button type="submit">Prześlij</button>
    <a class="button secondary" href="/admin/documents">Anuluj</a>
  </form>
</AdminLayout>

<script>
  const titleInput = document.getElementById("title-input") as HTMLInputElement | null;
  const fileInput = document.getElementById("file-input") as HTMLInputElement | null;
  fileInput?.addEventListener("change", () => {
    const file = fileInput.files?.[0];
    if (!file || !titleInput || titleInput.value.trim()) return;
    titleInput.value = file.name.replace(/\.[^./\\]+$/, "").replace(/[_-]+/g, " ").trim();
  });
</script>
