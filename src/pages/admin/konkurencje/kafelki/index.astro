---
import { env } from "cloudflare:workers";
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { listKonkurencjeTiles } from "../../../../lib/db";
import { mediaUrl } from "../../../../lib/media";

const { results: tiles } = await listKonkurencjeTiles(env.DB);

const saved = Astro.url.searchParams.get("saved");
const deleted = Astro.url.searchParams.get("deleted");
const errorParam = Astro.url.searchParams.get("error");
const ERROR_MESSAGES: Record<string, string> = {
  missing: "Tytuł i link są wymagane.",
  too_large: "Zdjęcie jest za duże (limit 10MB).",
  not_image: "Plik nie wygląda na prawidłowy obraz (JPEG/PNG/WebP).",
};
const errorMessage = errorParam ? ERROR_MESSAGES[errorParam] ?? "Wystąpił błąd." : null;
const csrfToken = Astro.locals.csrfToken;
---

<AdminLayout title="Kafelki konkurencji">
  <p class="breadcrumb"><a href="/admin/konkurencje">Konkurencje</a></p>
  <h1>Kafelki konkurencji</h1>
  <p class="doc-meta">
    Kafelki ze zdjęciami wyświetlane na stronie Konkurencje i na stronach poszczególnych dyscyplin — mogą
    prowadzić do dowolnej strony (dyscypliny, bloku, klasyfikacji itd.), niezależnie od struktury bloków.
  </p>

  {saved && <p class="form-error" style="background:#e8f5ea;border-color:#a8d5b0;color:#256029;">Zapisano.</p>}
  {deleted && <p class="form-error" style="background:#e8f5ea;border-color:#a8d5b0;color:#256029;">Usunięto.</p>}
  {errorMessage && <p class="form-error">{errorMessage}</p>}

  <h2>Nowy kafelek</h2>
  <form class="stacked" method="POST" enctype="multipart/form-data" action={`/api/admin/konkurencje/kafelki?csrf_token=${csrfToken}`}>
    <label>
      Tytuł
      <input type="text" name="title" required />
    </label>
    <label>
      Link (np. /konkurencje/sportowy/lekkoatletyka lub /klasyfikacje)
      <input type="text" name="link_url" placeholder="/konkurencje/sportowy/lekkoatletyka" required />
    </label>
    <label>
      Zdjęcie
      <input type="file" name="image" accept="image/jpeg,image/png,image/webp" />
    </label>
    <label>
      Kolejność
      <input type="number" name="sort_order" value="0" />
    </label>
    <button type="submit">Dodaj kafelek</button>
  </form>

  <h2>Istniejące kafelki</h2>
  {tiles.length === 0 ? (
    <p class="empty-state">Brak kafelków.</p>
  ) : (
    <table class="admin-table">
      <thead><tr><th></th><th>Tytuł</th><th>Link</th><th>Kolejność</th><th></th></tr></thead>
      <tbody>
        {tiles.map((tile) => (
          <tr>
            <td>
              {tile.image_key && (
                <img src={mediaUrl(env.MEDIA_BASE_URL, tile.image_key)} alt="" style="width:48px;height:48px;object-fit:cover;border-radius:4px;" />
              )}
            </td>
            <td>{tile.title}</td>
            <td>{tile.link_url}</td>
            <td>{tile.sort_order}</td>
            <td><a href={`/admin/konkurencje/kafelki/${tile.id}/edit`}>Edytuj</a></td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</AdminLayout>
