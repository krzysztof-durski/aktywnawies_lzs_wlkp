---
const { env } = Astro.locals.runtime;
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { getDisciplineById } from "../../../../lib/db";
import { KONKURENCJE_BLOCKS } from "../../../../lib/nav";
import { mediaUrl } from "../../../../lib/media";

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return new Response("Not found", { status: 404 });

const discipline = await getDisciplineById(env.DB, id);
if (!discipline) return new Response("Not found", { status: 404 });

const errorParam = Astro.url.searchParams.get("error");
const ERROR_MESSAGES: Record<string, string> = {
  "1": "Tytuł i blok są wymagane.",
  cover_too_large: "Zdjęcie jest za duże (limit 10MB).",
  cover_not_image: "Plik nie wygląda na prawidłowy obraz (JPEG/PNG/WebP).",
};
const errorMessage = errorParam ? ERROR_MESSAGES[errorParam] ?? "Wystąpił błąd." : null;
const csrfToken = Astro.locals.csrfToken;
---

<AdminLayout title={`Edytuj: ${discipline.title}`}>
  <h1>Edytuj dyscyplinę</h1>
  {errorMessage && <p class="form-error">{errorMessage}</p>}
  <form class="stacked" method="POST" enctype="multipart/form-data" action={`/api/admin/konkurencje/${id}?csrf_token=${csrfToken}`}>
    <label>
      Blok
      <select name="block" required>
        {KONKURENCJE_BLOCKS.map((block) => (
          <option value={block.slug} selected={block.slug === discipline.block}>{block.title}</option>
        ))}
      </select>
    </label>
    <label>
      Tytuł
      <input type="text" name="title" value={discipline.title} required />
    </label>
    <label>
      Slug
      <input type="text" name="slug" value={discipline.slug} />
    </label>
    <label>
      Opis (HTML)
      <textarea name="body_html">{discipline.body_html}</textarea>
    </label>
    {discipline.cover_image_key && (
      <div>
        <p>Obecne zdjęcie:</p>
        <img src={mediaUrl(env.MEDIA_BASE_URL, discipline.cover_image_key)} alt="" style="max-width:240px;border-radius:6px;" />
        <label style="font-weight:400;display:flex;gap:.4rem;align-items:center;margin-top:.5rem;">
          <input type="checkbox" name="remove_cover" style="width:auto;" /> Usuń zdjęcie
        </label>
      </div>
    )}
    <label>
      {discipline.cover_image_key ? "Zamień zdjęcie" : "Zdjęcie w nagłówku strony dyscypliny (opcjonalnie)"}
      <input type="file" name="cover_image" accept="image/jpeg,image/png,image/webp" />
    </label>
    <label>
      Kolejność
      <input type="number" name="sort_order" value={discipline.sort_order} />
    </label>
    <button type="submit">Zapisz</button>
    <a class="button secondary" href="/admin/konkurencje">Anuluj</a>
  </form>
  <form
    method="POST"
    action={`/api/admin/konkurencje/${id}?csrf_token=${csrfToken}`}
    style="margin-top:1rem;"
    data-confirm="Na pewno usunąć tę dyscyplinę?"
  >
    <input type="hidden" name="intent" value="delete" />
    <button type="submit" class="danger">Usuń</button>
  </form>
</AdminLayout>
