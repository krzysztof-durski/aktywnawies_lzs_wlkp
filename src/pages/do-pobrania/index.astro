---
const { env } = Astro.locals.runtime;
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocumentList from "../../components/DocumentList.astro";
import { listAllPublishedDocuments, getSiteSetting, type DocumentRow } from "../../lib/db";
import { mediaUrl } from "../../lib/media";
import fallbackRegulaminUrl from "../../assets/docs/Regulamin Aktywna Wieś Szreniawa.pdf?url";

const { results: documents } = await listAllPublishedDocuments(env.DB);

const regulaminTitle = (await getSiteSetting(env.DB, "regulamin_glowny_title")) || "Regulamin V Ogólnopolskich Igrzysk LZS „Aktywna Wieś”";
const regulaminKey = await getSiteSetting(env.DB, "regulamin_glowny_key");
const regulaminUrl = regulaminKey ? mediaUrl(env.MEDIA_BASE_URL, regulaminKey) : fallbackRegulaminUrl;

const grouped = documents.reduce<Record<string, DocumentRow[]>>((acc, doc) => {
  (acc[doc.category] ??= []).push(doc);
  return acc;
}, {});
const categories = Object.keys(grouped).sort();
---

<BaseLayout title="Do pobrania">
  <div class="container">
    <h1>Do pobrania</h1>

    <section>
      <h2>Regulamin Igrzysk</h2>
      <ul class="doc-list">
        <li>
          <div class="doc-row">
            <span>{regulaminTitle}</span>
            <a class="button secondary" href={regulaminUrl} download>Pobierz</a>
          </div>
        </li>
      </ul>
      <p class="doc-meta">
        Regulaminy poszczególnych konkurencji, listy startowe i wyniki są dostępne na stronie{" "}
        <a href="/konkurencje">Konkurencje</a>.
      </p>
    </section>

    {categories.length === 0 ? (
      <p class="empty-state">Brak pozostałych materiałów do pobrania.</p>
    ) : (
      categories.map((category) => (
        <section>
          <h2>{category}</h2>
          <DocumentList documents={grouped[category]} mediaBaseUrl={env.MEDIA_BASE_URL} />
        </section>
      ))
    )}
  </div>
</BaseLayout>
